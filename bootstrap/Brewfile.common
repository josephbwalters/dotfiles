# Shared across every OS's Brewfile - included via `eval File.read(...)`
# since the Brewfile format is just Ruby, and Homebrew Bundle has no
# native include/import directive.

tap "hashicorp/tap"

# Shell / prompt
brew "starship"
brew "zsh"

# CLI tools used directly in .zshrc / aliases.sh
brew "bat"
brew "btop"
brew "chezmoi"
brew "coreutils"
brew "direnv"
brew "eza"
brew "fastfetch"
brew "fd"
brew "fzf"
brew "git"
brew "git-filter-repo"
brew "glab"
brew "grep"
brew "helix"
brew "helm"
brew "herdr"
brew "jq"
brew "just"
brew "lazygit"
brew "llvm"
brew "lua@5.4"
brew "luarocks"
brew "mise"
brew "neovim"
brew "pre-commit"
brew "ripgrep"
brew "shellcheck"
brew "tcl-tk"
brew "tmux"
brew "hashicorp/tap/terraform"
brew "yarn"
brew "yazi"
brew "zoxide"
